index 0000000..0a4881b
--- /dev/null
+++ b/h_jepa/action_response.py
@@ -0,0 +1,64 @@
+"""Pairwise, antisymmetric action-response model.
+
+Input:
+    z0:    [B, 192]      frozen H-JEPA Level-1 latent
+    acts_a, acts_b: [B, 5, 2] raw Push-T environment actions
+Output:
+    r_ab:  [B, 192]      predicted E(o_A_end)-E(o_B_end)
+"""
+from dataclasses import dataclass
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+@dataclass(frozen=True)
+class ResponseConfig:
+    state_dim: int = 192
+    action_dim: int = 2
+    horizon: int = 5
+    hidden_dim: int = 384
+
+
+class ActionResponseNet(nn.Module):
+    """R(z,A,B) = phi(z,A) - phi(z,B).
+
+    The subtraction enforces:
+      R(z,A,A) == 0
+      R(z,A,B) == -R(z,B,A)
+    by construction, independently of training.
+    """
+
+    def __init__(self, cfg: ResponseConfig):
+        super().__init__()
+        self.cfg = cfg
+        input_dim = cfg.state_dim + cfg.horizon * cfg.action_dim
+        self.phi = nn.Sequential(
+            nn.LayerNorm(input_dim),
+            nn.Linear(input_dim, cfg.hidden_dim),
+            nn.SiLU(),
+            nn.Linear(cfg.hidden_dim, cfg.hidden_dim),
+            nn.SiLU(),
+            nn.Linear(cfg.hidden_dim, cfg.state_dim),
+        )
+
+    def potential(self, z0: torch.Tensor, actions: torch.Tensor):
+        if z0.ndim != 2 or z0.shape[-1] != self.cfg.state_dim:
+            raise ValueError(
+                f"z0 should be [B,{self.cfg.state_dim}], got {tuple(z0.shape)}"
+            )
+        required = (z0.shape[0], self.cfg.horizon, self.cfg.action_dim)
+        if tuple(actions.shape) != required:
+            raise ValueError(f"actions should be {required}, got {tuple(actions.shape)}")
+        x = torch.cat([z0, actions.reshape(z0.shape[0], -1)], dim=-1)
+        return self.phi(x)
+
+    def forward(self, z0, acts_a, acts_b):
+        return self.potential(z0, acts_a) - self.potential(z0, acts_b)
+
+
+def response_loss(pred: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
+    if pred.shape != target.shape:
+        raise ValueError(f"pred/target mismatch: {pred.shape} vs {target.shape}")
+    return F.mse_loss(pred.float(), target.float())
diff --git a/h_jepa/tests/test_action_response.py b/h_jepa/tests/test_action_response.py
new file mode 100644
index 0000000..1872bbd
--- /dev/null
+++ b/h_jepa/tests/test_action_response.py
@@ -0,0 +1,58 @@
+import pytest
+import torch
+
+from action_response import ActionResponseNet, ResponseConfig, response_loss
+
+
+def test_zero_effect_for_identical_actions():
+    cfg = ResponseConfig(state_dim=192, action_dim=2, horizon=5, hidden_dim=64)
+    model = ActionResponseNet(cfg).eval()
+    z = torch.randn(4, 192)
+    a = torch.randn(4, 5, 2)
+    torch.testing.assert_close(
+        model(z, a, a), torch.zeros(4, 192), atol=0, rtol=0
+    )
+
+
+def test_antisymmetry_and_shape():
+    cfg = ResponseConfig(state_dim=192, action_dim=2, horizon=5, hidden_dim=64)
+    model = ActionResponseNet(cfg).eval()
+    z = torch.randn(3, 192)
+    a = torch.randn(3, 5, 2)
+    b = torch.randn(3, 5, 2)
+    r_ab = model(z, a, b)
+    r_ba = model(z, b, a)
+    assert r_ab.shape == (3, 192)
+    torch.testing.assert_close(r_ab, -r_ba, atol=0, rtol=0)
+
+
+def test_wrong_action_time_shape_fails_fast():
+    model = ActionResponseNet(ResponseConfig())
+    z = torch.zeros(2, 192)
+    wrong = torch.zeros(2, 2, 5)
+    correct = torch.zeros(2, 5, 2)
+    with pytest.raises(ValueError):
+        model(z, wrong, correct)
+
+
+def test_gradient_and_tiny_overfit():
+    torch.manual_seed(7)
+    cfg = ResponseConfig(state_dim=12, action_dim=2, horizon=5, hidden_dim=48)
+    model = ActionResponseNet(cfg)
+    z = torch.randn(16, 12)
+    a, b = torch.randn(16, 5, 2), torch.randn(16, 5, 2)
+    weight = torch.randn(10, 12) / 4
+    target = (a.reshape(16, -1) - b.reshape(16, -1)) @ weight
+
+    optim = torch.optim.Adam(model.parameters(), lr=0.008)
+    with torch.no_grad():
+        before = response_loss(model(z, a, b), target).item()
+    for _ in range(45):
+        optim.zero_grad(set_to_none=True)
+        loss = response_loss(model(z, a, b), target)
+        loss.backward()
+        optim.step()
+    with torch.no_grad():
+        after = response_loss(model(z, a, b), target).item()
+    assert after < before * 0.5, (before, after)
+    assert all(torch.isfinite(p).all() for p in model.parameters())
